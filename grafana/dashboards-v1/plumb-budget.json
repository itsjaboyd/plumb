      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plumb-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.category          AS \"Category\",\n       s.period            AS \"Period\",\n       m.plan_amount       AS \"Per period\",\n       s.budget            AS \"Monthly\",\n       s.spent             AS \"Spent this month\",\n       s.envelope_balance  AS \"Balance\",\n       s.months_of_cover   AS \"Months covered\"\nFROM v_budget_status s\nJOIN v_budget_months m ON m.category_id = s.category_id\n                      AND m.month = s.month\nWHERE s.carry_forward AND (array_length(ARRAY[${category:sqlstring}]::text[], 1) IS NULL OR s.category = ANY(ARRAY[${category:sqlstring}]::text[]))\nORDER BY s.envelope_balance ASC NULLS FIRST"
        }
