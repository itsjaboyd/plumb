          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.name AS \"Category\",\n       to_char(p.valid_from, 'YYYY-MM') AS \"From\",\n       p.amount AS \"Per period\",\n       p.period AS \"Period\",\n       round(p.amount / budget_period_months(p.period), 2) AS \"Monthly\",\n       CASE WHEN p.carry_forward THEN 'yes' ELSE 'no' END AS \"Rolls over\",\n       p.opening_balance AS \"Opening balance\",\n       coalesce(p.note, '') AS \"Note\"\nFROM budget_plans p\nJOIN categories c ON c.id = p.category_id\nWHERE (array_length(ARRAY[${category:sqlstring}]::text[], 1) IS NULL OR c.name = ANY(ARRAY[${category:sqlstring}]::text[]))\nORDER BY c.name, p.valid_from DESC"
