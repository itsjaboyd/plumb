{
  "uid": "plumb-budget",
  "title": "Budget",
  "description": "Where the budget stands today and where it is heading. There is no month selector here on purpose: an envelope balance is a running total, so \"what was in the fund last March\" is a curiosity, while \"what is in it now and will it cover the next bill\" is the question. For how a closed month went against budget, use the budget strip on Monthly Review. Accounts are not a filter either - a budget belongs to a category, whichever card paid.",
  "tags": [
    "plumb"
  ],
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1y",
    "to": "now+6M"
  },
  "timepicker": {},
  "refresh": "",
  "fiscalYearStartMonth": 0,
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": true,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "query": {
          "datasource": {
            "name": "-- Grafana --"
          },
          "group": "grafana",
          "kind": "DataQuery",
          "spec": {},
          "version": "v0"
        },
        "datasource": {
          "name": "-- Grafana --"
        }
      }
    ]
  },
