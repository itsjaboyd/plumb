    {
      "id": 8,
      "type": "timeseries",
      "title": "Month's Pace",
      "description": "Spending this month adding up day by day, against a straight line to the month's total budget. Above the line means you are ahead of pace. The spending series stops at today rather than running flat to the month end. An EXISTS test picks the budgeted transactions so a transaction cannot be counted twice when a category and its parent both have plans.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 8,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "showValues": false,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Budget pace"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "text",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "values": []
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plumb-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH days AS (\n    SELECT generate_series(date_trunc('month', current_date)::date,\n                           (date_trunc('month', current_date)::date + interval '1 month - 1 day')::date,\n                           interval '1 day')::date AS d\n), plan AS (\n    SELECT coalesce(sum(budget), 0) AS budget\n    FROM v_budget_status WHERE (array_length(ARRAY[${category:sqlstring}]::text[], 1) IS NULL OR category = ANY(ARRAY[${category:sqlstring}]::text[]))\n), daily AS (\n    SELECT v.posted_on AS d, sum(v.outflow) AS amt\n    FROM v_spending v\n    WHERE date_trunc('month', v.posted_on)::date = date_trunc('month', current_date)::date\n      AND EXISTS (SELECT 1 FROM v_budget_status s\n                   WHERE s.category_id = ANY(v.category_id_path)\n                     AND (array_length(ARRAY[${category:sqlstring}]::text[], 1) IS NULL OR s.category = ANY(ARRAY[${category:sqlstring}]::text[])))\n    GROUP BY 1\n), run AS (\n    SELECT days.d,\n           sum(coalesce(daily.amt, 0)) OVER (ORDER BY days.d) AS cumulative,\n           plan.budget\n    FROM days\n    CROSS JOIN plan\n    LEFT JOIN daily ON daily.d = days.d\n)\nSELECT (d::timestamp AT TIME ZONE 'America/Denver') AS \"time\",\n       CASE WHEN d <= current_date THEN cumulative END AS \"Spent so far\",\n       round(budget * extract(day FROM d) / extract(day FROM date_trunc('month', current_date) + interval '1 month - 1 day'), 2) AS \"Budget pace\"\nFROM run\nORDER BY 1"
        }
      ],
      "links": [],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plumb-pg"
      }
    },
