          "rawQuery": true,
          "rawSql": "SELECT category AS metric, pct_used AS value\nFROM v_budget_status\nWHERE NOT carry_forward AND (array_length(ARRAY[${category:sqlstring}]::text[], 1) IS NULL OR category = ANY(ARRAY[${category:sqlstring}]::text[]))\nORDER BY pct_used DESC NULLS LAST"
