    {
      "id": 3,
      "type": "stat",
      "title": "Pace",
      "description": "Spending so far, stretched over the whole month, as a share of budget. 100% means you are exactly on track to spend the budget; 130% means you are heading 30% over if the rest of the month looks like the start of it. Jumpy in the first few days, by design - it is a projection.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 100,
          "min": 0,
          "noValue": "no plan",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "red",
                "value": 105
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plumb-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (\n    SELECT coalesce(sum(spent), 0) AS spent, sum(budget) AS budget\n    FROM v_budget_status WHERE (array_length(ARRAY[${category:sqlstring}]::text[], 1) IS NULL OR category = ANY(ARRAY[${category:sqlstring}]::text[]))\n)\nSELECT round(100.0 * (spent / (extract(day FROM current_date) / extract(day FROM date_trunc('month', current_date) + interval '1 month - 1 day')))\n             / nullif(budget, 0), 1) AS \"Pace\"\nFROM s"
        }
      ],
      "links": [],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plumb-pg"
      }
    },
