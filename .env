# Copy to .env and change every password. .env is gitignored.
#   cp .env.example .env

# --- Identity ---------------------------------------------------------
# Namespaces everything Docker creates: volumes, network, containers and
# the ETL image. Change it (and the two ports below) in each copy if you
# run more than one stack on this machine - two stacks sharing a project
# name would share one database.
COMPOSE_PROJECT_NAME=plumb

# --- Database ---------------------------------------------------------
POSTGRES_DB=plumb
POSTGRES_USER=plumb
POSTGRES_PASSWORD=change-me-app
POSTGRES_PORT=5432

# Read-only login Grafana uses. Created on the database's first boot.
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change-me-readonly

# --- Grafana ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000

# --- Misc -------------------------------------------------------------
# Container time zone. Note that the views name a zone explicitly where it
# matters, so if you move, change it here AND in db/migrations/002_views.sql
# (search for AT TIME ZONE) - see "Time zones" in the README.
TZ=America/Denver
